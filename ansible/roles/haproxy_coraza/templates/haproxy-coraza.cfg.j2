frontend {{ haproxy_coraza_frontend_name }}
    mode http
    bind {{ haproxy_coraza_bind }}
    filter spoe engine coraza config /etc/haproxy/coraza.cfg
    # Act on the verdict Coraza returns in txn.coraza.action
    http-request deny deny_status 403 if { var(txn.coraza.action) -m str deny }
    http-request deny deny_status 500 if { var(txn.coraza.error) -m int gt 0 }
    use_backend {{ haproxy_coraza_backend_name }}

backend {{ haproxy_coraza_backend_name }}
    mode http
{% if haproxy_coraza_backend_servers | length > 0 %}
{% for server in haproxy_coraza_backend_servers %}
    server {{ server.name }} {{ server.address }} check
{% endfor %}
{% else %}
    http-request return status 200 content-type "text/plain" string "Welcome!\n"
{% endif %}

backend coraza-spoa
    mode tcp
    balance roundrobin
    server s1 {{ haproxy_coraza_agent_address }}
